  "topology_analysis": {
    "critical_paths": [
      {
        "path": [
          "gateway",
          "clinical_dashboard_service",
          "clinical_workflow_service",
          "clinical_db"
        ],
        "latency_ms": 120,
        "criticality": "high",
        "reason": "Primary clinical workflow path used during patient visits - affects 70% of clinician interactions"
      },
      {
        "path": [
          "gateway",
          "patient_portal_service",
          "patient_records_service",
          "patient_db"
        ],
        "latency_ms": 100,
        "criticality": "high",
        "reason": "Patient self-service portal - affects patient satisfaction and reduces support calls"
      },
      {
        "path": [
          "gateway",
          "clinical_dashboard_service",
          "imaging_service",
          "lab_results_api"
        ],
        "latency_ms": 300,
        "criticality": "medium",
        "reason": "Medical imaging and lab integration - critical for diagnosis but lower frequency"
      }
    ],
    "bottlenecks": [
      {
        "node_id": "clinical_db",
        "type": "resource_contention",
        "severity": "high",
        "reason": "Central database for all clinical data - handles complex medical record queries with ACID compliance requirements",
        "symptoms": [
          "high_latency",
          "connection_pool_exhaustion",
          "lock_contention",
          "query_timeout"
        ]
      },
      {
        "node_id": "records_cache",
        "type": "cache_saturation",
        "severity": "medium",
        "reason": "Frequently accessed patient records cache - eviction pressure during peak clinical hours",
        "symptoms": [
          "cache_miss_rate_increase",
          "database_query_spike",
          "response_time_degradation"
        ]
      },
      {
        "node_id": "imaging_service",
        "type": "cpu_intensive_processing",
        "severity": "medium",
        "reason": "Medical image processing and DICOM format conversion requires significant CPU resources",
        "symptoms": [
          "high_cpu_utilization",
          "processing_queue_buildup",
          "memory_pressure"
        ]
      }
    ],
    "failure_modes": [
      {
        "fault_type": "database_failure",
        "target": "clinical_db",
        "likelihood": "low",
        "impact": "critical",
        "propagation": [
          "All clinical workflows halt",
          "Emergency read-only mode activated",
          "Patient safety alerts triggered"
        ],
        "detection_signals": [
          "connection_refused",
          "query_timeout_spike",
          "health_check_failures"
        ]
      },
      {
        "fault_type": "service_crash",
        "target": "clinical_workflow_service",
        "likelihood": "medium",
        "impact": "high",
        "propagation": [
          "Clinician dashboard shows errors",
          "Insurance verification fails",
          "Appointment scheduling blocked"
        ],
        "detection_signals": [
          "error_rate_spike",
          "pod_restarts",
          "upstream_5xx_errors"
        ]
      },
      {
        "fault_type": "external_api_timeout",
        "target": "insurance_api",
        "likelihood": "high",
        "impact": "medium",
        "propagation": [
          "Insurance verification delays",
          "Claims processing backlog",
          "Manual verification required"
        ],
        "detection_signals": [
          "external_api_latency_spike",
          "timeout_rate_increase",
          "fallback_activation"
        ]
      },
      {
        "fault_type": "cache_failure",
        "target": "records_cache",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Database query load increases 5x",
          "Response times degrade",
          "Session management affected"
        ],
        "detection_signals": [
          "cache_connection_errors",
          "database_cpu_spike",
          "latency_p99_increase"
        ]
      },
      {
        "fault_type": "network_partition",
        "target": "lab_results_api",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Lab results unavailable",
          "Diagnostic delays",
          "Manual result entry required"
        ],
        "detection_signals": [
          "network_timeout",
          "dns_resolution_failure",
          "circuit_breaker_open"
        ]
      }
    ],
    "dependencies": [
      {
        "service": "clinical_workflow_service",
        "depends_on": [
          "clinical_db",
          "records_cache",
          "insurance_api"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "Service fails for new workflows if clinical_db is down, degrades gracefully if insurance_api is unavailable"
      },
      {
        "service": "patient_records_service",
        "depends_on": [
          "patient_db",
          "records_cache"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "Service becomes read-only if patient_db fails, continues with degraded performance if cache fails"
      },
      {
        "service": "imaging_service",
        "depends_on": [
          "clinical_db",
          "lab_results_api"
        ],
        "dependency_strength": "soft",
        "failure_behavior": "Can process local images without lab_results_api, requires clinical_db for metadata storage"
      },
      {
        "service": "analytics_service",
        "depends_on": [
          "clinical_db",
          "analytics_queue"
        ],
        "dependency_strength": "soft",
        "failure_behavior": "Queue provides buffering during database outages, can resume processing when db recovers"
      }
    ]
  }
}