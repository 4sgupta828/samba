{
  "domain": "Healthcare Records Management",
  "description": "A HIPAA-compliant healthcare records management system with strict layered architecture for security and auditability. Handles patient records, clinical workflows, and analytics with clear separation of concerns.",
  "architecture_name": "Enterprise Healthcare Records Management System",
  "archetype": "hierarchical",
  "pros": [
    "Clear security boundaries between layers for HIPAA compliance",
    "Predictable request flow makes audit trails easy to follow",
    "Separation of clinical data from analytics reduces compliance scope",
    "Easy to implement role-based access control at layer boundaries"
  ],
  "cons": [
    "Rigid layer structure can increase latency for simple operations",
    "Cross-cutting concerns like notifications require complex routing",
    "Database layer can become bottleneck without careful capacity planning",
    "Limited flexibility for real-time clinical decision support features"
  ],
