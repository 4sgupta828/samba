    "meta": {
      "architecture_name": "IoT Telemetry Processing Pipeline",
      "archetype": "pipeline",
      "domain": "IoT Telemetry Processing",
      "description": "Real-time IoT data processing pipeline that ingests telemetry from devices, validates and enriches data, performs anomaly detection, stores metrics, and triggers alerts. Sequential processing stages ensure data quality and proper transformation at each step.",
      "pros": [
        "Scalable processing stages can be tuned independently",
        "Fault isolation between pipeline stages",
        "Easy to add new processing stages",
        "Built-in backpressure handling with queues",
        "Real-time anomaly detection and alerting"
      ],
      "cons": [
        "Higher latency due to multi-stage processing",
        "Complex monitoring across pipeline stages",
        "Queue management overhead",
        "Potential data loss if queues overflow"
      ]
    },
