  "topology_analysis": {
    "critical_paths": [
      {
        "path": [
          "gateway",
          "upload_service",
          "upload_queue",
          "validation_service",
          "validation_queue",
          "transcoding_service"
        ],
        "latency_ms": 15000,
        "criticality": "high",
        "reason": "Core video processing pipeline - affects all uploaded content"
      },
      {
        "path": [
          "gateway",
          "metadata_service",
          "video_metadata_db"
        ],
        "latency_ms": 200,
        "criticality": "high",
        "reason": "Video metadata queries - affects user experience for browsing"
      },
      {
        "path": [
          "transcoding_service",
          "transcoding_queue",
          "quality_check_service",
          "quality_queue",
          "thumbnail_service"
        ],
        "latency_ms": 8000,
        "criticality": "medium",
        "reason": "Post-processing pipeline for video assets"
      },
      {
        "path": [
          "publishing_service",
          "cdn_service"
        ],
        "latency_ms": 500,
        "criticality": "high",
        "reason": "Content delivery setup - affects video availability"
      }
    ],
    "bottlenecks": [
      {
        "node_id": "transcoding_service",
        "type": "resource_contention",
        "severity": "high",
        "reason": "CPU-intensive transcoding operations can create queue backlog during peak upload times",
        "symptoms": [
          "queue_depth_increase",
          "processing_latency_spike",
          "cpu_utilization_high"
        ]
      },
      {
        "node_id": "video_metadata_db",
        "type": "resource_contention",
        "severity": "high",
        "reason": "Single database handles all video metadata writes from multiple pipeline stages",
        "symptoms": [
          "connection_pool_exhaustion",
          "write_latency_increase",
          "deadlock_frequency_spike"
        ]
      },
      {
        "node_id": "transcoding_queue",
        "type": "capacity_limit",
        "severity": "medium",
        "reason": "Large video files can cause queue message size limits and memory pressure",
        "symptoms": [
          "queue_depth_spike",
          "message_processing_errors",
          "memory_pressure"
        ]
      },
      {
        "node_id": "cdn_service",
        "type": "external_dependency",
        "severity": "medium",
        "reason": "External CDN API rate limits can block content publishing",
        "symptoms": [
          "api_rate_limit_errors",
          "publishing_delays",
          "retry_queue_buildup"
        ]
      }
    ],
    "failure_modes": [
      {
        "fault_type": "service_crash",
        "target": "transcoding_service",
        "likelihood": "medium",
        "impact": "high",
        "propagation": [
          "Transcoding queue backs up",
          "Quality check service starves",
          "Pipeline processing halts"
        ],
        "detection_signals": [
          "pod_restarts",
          "queue_depth_spike",
          "processing_throughput_drop"
        ]
      },
      {
        "fault_type": "database_failure",
        "target": "video_metadata_db",
        "likelihood": "low",
        "impact": "critical",
        "propagation": [
          "All pipeline stages fail",
          "Upload service rejects requests",
          "Metadata queries fail"
        ],
        "detection_signals": [
          "database_connection_errors",
          "write_failure_spike",
          "service_error_rate_increase"
        ]
      },
      {
        "fault_type": "queue_overflow",
        "target": "upload_queue",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "New uploads rejected",
          "Validation service processing delays",
          "User upload failures"
        ],
        "detection_signals": [
          "queue_depth_critical",
          "message_reject_rate_spike",
          "upload_error_rate_increase"
        ]
      },
      {
        "fault_type": "external_service_timeout",
        "target": "cdn_service",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Publishing service retries",
          "Content delivery delays",
          "Publishing queue backlog"
        ],
        "detection_signals": [
          "external_api_timeout_spike",
          "retry_rate_increase",
          "publishing_latency_increase"
        ]
      },
      {
        "fault_type": "high_latency",
        "target": "validation_service",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Transcoding delays",
          "Pipeline throughput reduction",
          "User experience degradation"
        ],
        "detection_signals": [
          "validation_latency_spike",
          "queue_processing_slowdown",
          "sla_breach_alerts"
        ]
      },
      {
        "fault_type": "memory_exhaustion",
        "target": "quality_check_service",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Service crashes",
          "Quality queue backup",
          "Thumbnail generation delays"
        ],
        "detection_signals": [
          "memory_usage_critical",
          "oom_kills",
          "processing_capacity_drop"
        ]
      }
    ],
    "dependencies": [
      {
        "service": "upload_service",
        "depends_on": [
          "video_metadata_db",
          "redis_cache"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "upload_service fails immediately if video_metadata_db is down, degrades with cache failures"
      },
      {
        "service": "transcoding_service",
        "depends_on": [
          "video_metadata_db"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "transcoding_service cannot update progress without database access"
      },
      {
        "service": "publishing_service",
        "depends_on": [
          "video_metadata_db",
          "cdn_service"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "publishing_service fails if cannot write status to database or upload to CDN"
      },
      {
        "service": "analytics_service",
        "depends_on": [
          "analytics_db"
        ],
        "dependency_strength": "soft",
        "failure_behavior": "analytics_service can buffer events temporarily if database is unavailable"
      }
    ]
  }
}