  "services": {
    "gateway": {
      "id": "gateway",
      "type": "RequestGateway"
    },
    "upload_service": {
      "id": "upload_service",
      "type": "Service",
      "profile": "io_intensive",
      "replicas": 3,
      "async_consumer_capacity": 150
    },
    "validation_service": {
      "id": "validation_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 4,
      "async_consumer_capacity": 120
    },
    "transcoding_service": {
      "id": "transcoding_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 6,
      "async_consumer_capacity": 180
    },
    "quality_check_service": {
      "id": "quality_check_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 3,
      "async_consumer_capacity": 90
    },
    "thumbnail_service": {
      "id": "thumbnail_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 4,
      "async_consumer_capacity": 120
    },
    "metadata_service": {
      "id": "metadata_service",
      "type": "Service",
      "profile": "standard",
      "replicas": 3,
      "async_consumer_capacity": 180
    },
    "publishing_service": {
