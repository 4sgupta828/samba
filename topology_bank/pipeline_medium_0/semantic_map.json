{
  "domain": "Video Content Platform",
  "description": "Sequential video processing pipeline with upload validation, transcoding, quality checks, thumbnail generation, and content delivery",
  "architecture_name": "Video Processing Pipeline",
  "archetype": "pipeline",
  "pros": [
    "Clear separation of concerns",
    "Parallel processing stages",
    "Easy to scale individual stages",
    "Fault isolation between stages",
    "Easy to add new processing steps"
  ],
  "cons": [
    "High latency for full pipeline",
    "Complex error handling across stages",
    "Queue management overhead",
    "Potential for stage imbalances",
    "Difficult end-to-end debugging"
  ],
  "request_flows": {
