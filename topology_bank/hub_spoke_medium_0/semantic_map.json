  "services": {
    "gateway": {
      "id": "gateway",
      "type": "RequestGateway"
    },
    "home_hub_service": {
      "id": "home_hub_service",
      "type": "Service",
      "profile": "standard",
      "replicas": 4
    },
    "device_management_service": {
      "id": "device_management_service",
      "type": "Service",
      "profile": "io_intensive",
      "replicas": 3
    },
    "automation_engine_service": {
      "id": "automation_engine_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 4,
      "async_consumer_capacity": 160
    },
    "security_monitoring_service": {
      "id": "security_monitoring_service",
      "type": "Service",
      "profile": "latency_sensitive",
      "replicas": 3
    },
    "energy_management_service": {
      "id": "energy_management_service",
      "type": "Service",
      "profile": "standard",
      "replicas": 2
    },
    "user_interface_service": {
      "id": "user_interface_service",
      "type": "Service",
      "profile": "standard",
      "replicas": 3
    },
    "telemetry_processor_service": {
      "id": "telemetry_processor_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 4,
      "async_consumer_capacity": 120
    },
    "notification_service": {
      "id": "notification_service",
      "type": "Service",
      "profile": "standard",
      "replicas": 2,
      "async_consumer_capacity": 150
    },
    "analytics_service": {
      "id": "analytics_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 3,
      "async_consumer_capacity": 90
    },
    "device_registry_db": {
      "id": "device_registry_db",
      "type": "SqlDatabase",
      "replicas": 3
    },
    "user_data_db": {
      "id": "user_data_db",
      "type": "SqlDatabase",
      "replicas": 3
    },
    "telemetry_cache": {
      "id": "telemetry_cache",
      "type": "ExternalCache",
      "replicas": 3
    },
    "device_state_cache": {
      "id": "device_state_cache",
      "type": "ExternalCache",
      "replicas": 3
    },
    "automation_queue": {
      "id": "automation_queue",
      "type": "MessageQueue",
      "replicas": 3
    },
    "telemetry_queue": {
      "id": "telemetry_queue",
      "type": "MessageQueue",
      "replicas": 3
    },
    "notification_queue": {
      "id": "notification_queue",
      "type": "MessageQueue",
      "replicas": 3
    },
    "cloud_storage_service": {
      "id": "cloud_storage_service",
      "type": "ExternalService"
    }
  },
  "topology_analysis": {
    "critical_paths": [
      {
        "path": [
          "gateway",
          "home_hub_service",
          "device_management_service",
          "device_state_cache"
        ],
        "latency_ms": 45,
        "criticality": "high",
        "reason": "Real-time device status updates - affects user interface responsiveness"
      },
      {
        "path": [
          "gateway",
          "home_hub_service",
          "security_monitoring_service",
          "device_registry_db"
        ],
        "latency_ms": 80,
        "criticality": "high",
        "reason": "Security event processing - critical for home safety"
      },
      {
        "path": [
          "home_hub_service",
          "telemetry_queue",
          "telemetry_processor_service"
        ],
        "latency_ms": 120,
        "criticality": "medium",
        "reason": "Telemetry processing pipeline - affects energy analytics and trends"
      },
      {
        "path": [
          "automation_engine_service",
          "automation_queue",
          "automation_engine_service"
        ],
        "latency_ms": 200,
        "criticality": "high",
        "reason": "Automation rule execution - core functionality for smart home workflows"
      }
    ],
    "bottlenecks": [
      {
        "node_id": "home_hub_service",
        "type": "resource_contention",
        "severity": "high",
        "reason": "Central orchestrator handles all user requests and device coordination - single point of scaling limitation",
        "symptoms": [
          "high_cpu_usage",
          "request_queue_buildup",
          "increased_response_times"
        ]
      },
      {
        "node_id": "device_state_cache",
        "type": "resource_contention",
        "severity": "medium",
        "reason": "Frequent device status updates and reads can saturate cache memory and connections",
        "symptoms": [
          "cache_evictions",
          "memory_pressure",
          "connection_pool_exhaustion"
        ]
      },
      {
        "node_id": "telemetry_queue",
        "type": "throughput_limitation",
        "severity": "medium",
        "reason": "High-frequency sensor data can overwhelm queue capacity during peak usage",
        "symptoms": [
          "message_backlog",
          "producer_throttling",
          "consumer_lag"
        ]
      },
      {
        "node_id": "device_registry_db",
        "type": "resource_contention",
        "severity": "medium",
        "reason": "Central device metadata storage with frequent reads/writes from multiple services",
        "symptoms": [
          "slow_queries",
          "connection_timeouts",
          "lock_contention"
        ]
      }
    ],
    "failure_modes": [
      {
        "fault_type": "service_crash",
        "target": "home_hub_service",
        "likelihood": "medium",
        "impact": "critical",
        "propagation": [
          "Complete system unavailability",
          "All device control stops",
          "No user interface access"
        ],
        "detection_signals": [
          "error_rate_spike",
          "zero_successful_requests",
          "pod_restart_loop"
        ]
      },
      {
        "fault_type": "database_failure",
        "target": "device_registry_db",
        "likelihood": "low",
        "impact": "high",
        "propagation": [
          "Device management stops",
          "Security monitoring degraded",
          "Cannot add new devices"
        ],
        "detection_signals": [
          "connection_refused",
          "query_timeouts",
          "replica_lag_spike"
        ]
      },
      {
        "fault_type": "cache_failure",
        "target": "device_state_cache",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Slower device status updates",
          "Increased database load",
          "UI responsiveness degraded"
        ],
        "detection_signals": [
          "cache_miss_ratio_spike",
          "database_query_increase",
          "latency_increase"
        ]
      },
      {
        "fault_type": "queue_saturation",
        "target": "telemetry_queue",
        "likelihood": "high",
        "impact": "medium",
        "propagation": [
          "Telemetry data loss",
          "Analytics delayed",
          "Energy monitoring gaps"
        ],
        "detection_signals": [
          "queue_depth_spike",
          "message_drop_rate",
          "consumer_lag_increase"
        ]
      },
      {
        "fault_type": "network_partition",
        "target": "cloud_storage_service",
        "likelihood": "medium",
        "impact": "low",
        "propagation": [
          "Historical data archiving stops",
          "Analytics data incomplete",
          "No immediate user impact"
        ],
        "detection_signals": [
          "external_api_errors",
          "timeout_rate_spike",
          "retry_exhaustion"
        ]
      },
      {
        "fault_type": "high_latency",
        "target": "automation_engine_service",
        "likelihood": "medium",
        "impact": "high",
        "propagation": [
          "Delayed automation responses",
          "Security alerts delayed",
          "Poor user experience"
        ],
        "detection_signals": [
          "p99_latency_spike",
          "timeout_increase",
          "user_complaints"
        ]
      }
    ],
    "dependencies": [
      {
        "service": "home_hub_service",
        "depends_on": [
          "device_management_service",
          "automation_engine_service",
          "security_monitoring_service"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "Hub service fails immediately if any spoke service is unavailable"
      },
      {
        "service": "device_management_service",
        "depends_on": [
          "device_registry_db",
          "device_state_cache"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "Cannot read device state without cache, cannot persist without database"
      },
      {
        "service": "automation_engine_service",
        "depends_on": [
          "user_data_db",
          "automation_queue"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "Cannot execute rules without database access or queue for async processing"
      },
      {
        "service": "telemetry_processor_service",
        "depends_on": [
          "telemetry_cache",
          "cloud_storage_service"
        ],
        "dependency_strength": "soft",
        "failure_behavior": "Can continue processing with degraded performance if cloud storage fails"
      }
    ]
  }
}