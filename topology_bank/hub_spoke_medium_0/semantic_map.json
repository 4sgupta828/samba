      "entertainment_service": [
        "devices_db",
        "device_cache"
      ],
      "device_state_service": [
        "devices_db",
        "device_cache"
      ]
    },
    "DELETE": {
      "gateway": [
        "hub_orchestrator"
      ],
      "hub_orchestrator": [
        "lighting_service",
        "climate_service",
        "security_service",
        "entertainment_service",
        "device_state_service"
      ],
      "lighting_service": [
        "devices_db",
        "device_cache"
      ],
      "climate_service": [
        "devices_db",
        "device_cache"
      ],
      "security_service": [
        "devices_db",
        "device_cache"
