{
  "domain": "IoT Smart Home Management",
  "description": "Centralized smart home platform that orchestrates device control, automation, and monitoring across multiple IoT device types and protocols",
  "architecture_name": "Smart Home Hub Platform",
  "archetype": "hub_spoke",
  "pros": [
    "Centralized device orchestration",
    "Protocol abstraction",
    "Simplified automation rules",
    "Unified device management",
    "Easy integration of new device types"
  ],
  "cons": [
    "Single point of failure at hub",
    "Hub can become performance bottleneck",
    "Complex hub logic",
    "Limited direct device-to-device communication"
  ],
  "request_flows": {
    "GET": {
      "gateway": [
        "hub_orchestrator"
      ],
      "hub_orchestrator": [
        "lighting_service",
        "climate_service",
        "security_service",
        "entertainment_service",
        "device_state_service",
        "session_cache"
      ],
      "lighting_service": [
        "device_cache",
        "devices_db"
      ],
      "climate_service": [
        "device_cache",
        "devices_db"
      ],
      "security_service": [
        "device_cache",
        "devices_db"
      ],
      "entertainment_service": [
        "device_cache",
        "devices_db"
      ],
      "device_state_service": [
        "device_cache",
        "devices_db"
      ]
    },
    "POST": {
      "gateway": [
        "hub_orchestrator"
      ],
      "hub_orchestrator": [
        "lighting_service",
        "climate_service",
        "security_service",
        "entertainment_service",
        "device_events_queue",
        "automation_queue"
      ],
      "lighting_service": [
        "devices_db",
        "cloud_iot_platform"
      ],
      "climate_service": [
        "devices_db",
        "cloud_iot_platform"
      ],
      "security_service": [
        "devices_db",
        "notification_queue"
      ],
      "entertainment_service": [
        "devices_db"
      ],
      "device_events_queue": [
        "analytics_service"
      ],
      "automation_queue": [
        "automation_engine"
      ],
      "automation_engine": [
        "automation_db"
      ],
      "analytics_service": [
        "automation_db"
      ],
      "notification_queue": [
        "notification_service"
      ],
      "notification_service": [
        "devices_db"
      ]
    },
    "PUT": {
      "gateway": [
        "hub_orchestrator"
      ],
      "hub_orchestrator": [
        "lighting_service",
        "climate_service",
        "security_service",
        "entertainment_service",
        "device_state_service"
