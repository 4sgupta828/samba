      "async_consumer_capacity": 120
    },
    "devices_db": {
      "id": "devices_db",
      "type": "SqlDatabase",
      "replicas": 3
    },
    "automation_db": {
      "id": "automation_db",
      "type": "SqlDatabase",
      "replicas": 3
    },
    "device_cache": {
      "id": "device_cache",
      "type": "ExternalCache",
      "replicas": 3
    },
    "session_cache": {
      "id": "session_cache",
      "type": "ExternalCache",
      "replicas": 3
    },
    "device_events_queue": {
      "id": "device_events_queue",
      "type": "MessageQueue",
      "replicas": 3
    },
    "automation_queue": {
      "id": "automation_queue",
      "type": "MessageQueue",
      "replicas": 3
