{
  "domain": "Smart Home Automation",
  "description": "Central IoT hub manages devices, automation rules, and user interactions across multiple smart home systems",
  "architecture_name": "Smart Home IoT Platform",
  "archetype": "hub_spoke",
  "pros": [
    "Centralized device orchestration",
    "Simplified device management",
    "Cross-device automation workflows",
    "Single point of control"
  ],
  "cons": [
    "Hub becomes single point of failure",
    "All communication flows through central service",
    "Scaling bottleneck at orchestrator"
  ],
