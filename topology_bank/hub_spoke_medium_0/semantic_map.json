  "services": {
    "gateway": {
      "id": "gateway",
      "type": "RequestGateway"
    },
    "hub_orchestrator": {
      "id": "hub_orchestrator",
      "type": "Service",
      "profile": "standard",
      "replicas": 4
    },
    "lighting_service": {
      "id": "lighting_service",
      "type": "Service",
      "profile": "latency_sensitive",
      "replicas": 3
    },
    "climate_service": {
      "id": "climate_service",
      "type": "Service",
      "profile": "io_intensive",
      "replicas": 2
    },
    "security_service": {
      "id": "security_service",
      "type": "Service",
      "profile": "latency_sensitive",
      "replicas": 4
    },
    "entertainment_service": {
      "id": "entertainment_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 3
    },
    "automation_engine": {
      "id": "automation_engine",
      "type": "Service",
      "profile": "standard",
