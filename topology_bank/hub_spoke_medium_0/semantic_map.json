    },
    "analytics_service": {
      "id": "analytics_service",
      "type": "Service",
      "profile": "cpu_intensive",
      "replicas": 4,
      "async_consumer_capacity": 160
    },
    "notification_service": {
      "id": "notification_service",
      "type": "Service",
      "profile": "standard",
