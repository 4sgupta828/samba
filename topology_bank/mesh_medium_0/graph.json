    "meta": {
      "architecture_name": "Real-time Gaming Platform",
      "archetype": "mesh",
      "domain": "Gaming Platform",
      "description": "A real-time multiplayer gaming platform with high service interconnectivity for player management, matchmaking, game state synchronization, and analytics. Services communicate heavily with each other while maintaining layered architecture to prevent cycles.",
      "pros": [
        "High service interconnectivity enables rich feature interactions",
        "Shared infrastructure reduces data duplication",
        "Multiple communication paths improve resilience",
        "Real-time capabilities for gaming workloads"
      ],
      "cons": [
        "Complex service dependencies increase operational overhead",
        "Harder to isolate failures due to interconnected nature",
        "Network latency can accumulate across service hops",
        "Requires careful orchestration of deployments"
      ]
    },
