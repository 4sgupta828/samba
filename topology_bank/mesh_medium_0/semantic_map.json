  "topology_analysis": {
    "critical_paths": [
      {
        "path": [
          "gateway",
          "match_service",
          "game_engine_service",
          "game_state_db"
        ],
        "latency_ms": 85,
        "criticality": "high",
        "reason": "Core matchmaking and game state management - affects real-time gameplay experience"
      },
      {
        "path": [
          "gateway",
          "player_service",
          "player_db"
        ],
        "latency_ms": 120,
        "criticality": "high",
        "reason": "Player authentication and profile access - required for 90% of requests"
      },
      {
        "path": [
          "gateway",
          "social_service",
          "leaderboard_service",
          "leaderboard_cache"
        ],
        "latency_ms": 95,
        "criticality": "medium",
        "reason": "Social features and rankings - impacts user engagement but not core gameplay"
      },
      {
        "path": [
          "match_service",
          "game_events_queue",
          "analytics_service"
        ],
        "latency_ms": 200,
        "criticality": "low",
        "reason": "Analytics processing - important for business metrics but not user-facing"
      }
    ],
    "bottlenecks": [
      {
        "node_id": "player_db",
        "type": "resource_contention",
        "severity": "high",
        "reason": "Central database handles all player data, profile updates, and social connections - connection pool saturation likely under high load",
        "symptoms": [
          "high_latency",
          "connection_pool_exhaustion",
          "deadlock_detection"
        ]
      },
      {
        "node_id": "match_service",
        "type": "cpu_contention",
        "severity": "high",
        "reason": "Complex matchmaking algorithms and real-time coordination with multiple services creates CPU bottleneck",
        "symptoms": [
          "high_cpu_usage",
          "matchmaking_timeout",
          "queue_buildup"
        ]
      },
      {
        "node_id": "session_cache",
        "type": "memory_pressure",
        "severity": "medium",
        "reason": "Shared cache for multiple services storing active game sessions and temporary data",
        "symptoms": [
          "cache_eviction_rate_spike",
          "memory_pressure",
          "increased_db_load"
        ]
      },
      {
        "node_id": "game_engine_service",
        "type": "resource_contention",
        "severity": "medium",
        "reason": "CPU-intensive game logic processing with high replica count but limited per-instance capacity",
        "symptoms": [
          "processing_delays",
          "high_cpu_usage",
          "request_timeouts"
        ]
      }
    ],
    "failure_modes": [
      {
        "fault_type": "database_failure",
        "target": "player_db",
        "likelihood": "medium",
        "impact": "high",
        "propagation": [
          "All player-related services fail",
          "Authentication becomes impossible",
          "Social features unavailable",
          "Inventory management fails"
        ],
        "detection_signals": [
          "connection_failures",
          "query_timeout_spikes",
          "error_rate_increase"
        ]
      },
      {
        "fault_type": "service_crash",
        "target": "match_service",
        "likelihood": "high",
        "impact": "high",
        "propagation": [
          "New game matching stops",
          "Real-time game coordination fails",
          "Player queue buildup",
          "Game engine becomes unreachable"
        ],
        "detection_signals": [
          "pod_restarts",
          "matchmaking_timeout",
          "queue_depth_increase",
          "5xx_error_rate"
        ]
      },
      {
        "fault_type": "cache_failure",
        "target": "session_cache",
        "likelihood": "medium",
        "impact": "medium",
        "propagation": [
          "Database load increases significantly",
          "Response times degrade across all services",
          "Session validation becomes slower"
        ],
        "detection_signals": [
          "cache_miss_rate_spike",
          "database_connection_increase",
          "latency_increase"
        ]
      },
      {
        "fault_type": "network_partition",
        "target": "game_engine_service",
        "likelihood": "low",
        "impact": "high",
        "propagation": [
          "Active games become unresponsive",
          "Match service cannot coordinate game state",
          "Players experience disconnections"
        ],
        "detection_signals": [
          "connection_timeout",
          "network_error_increase",
          "game_state_sync_failures"
        ]
      },
      {
        "fault_type": "high_latency",
        "target": "leaderboard_service",
        "likelihood": "medium",
        "impact": "low",
        "propagation": [
          "Social features slow down",
          "Player rankings become stale",
          "Inventory lookups affected via service mesh calls"
        ],
        "detection_signals": [
          "p99_latency_spike",
          "slow_query_detection",
          "cache_performance_degradation"
        ]
      },
      {
        "fault_type": "queue_overflow",
        "target": "game_events_queue",
        "likelihood": "medium",
        "impact": "low",
        "propagation": [
          "Analytics processing falls behind",
          "Game event data loss",
          "Business metrics delayed"
        ],
        "detection_signals": [
          "queue_depth_alarm",
          "consumer_lag_increase",
          "message_loss_detection"
        ]
      }
    ],
    "dependencies": [
      {
        "service": "match_service",
        "depends_on": [
          "player_service",
          "game_engine_service",
          "game_state_db"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "match_service fails immediately if game_state_db is down, degrades without player_service connectivity"
      },
      {
        "service": "player_service",
        "depends_on": [
          "player_db",
          "session_cache"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "player_service fails completely if player_db is unavailable, performance degrades without session_cache"
      },
      {
        "service": "social_service",
        "depends_on": [
          "player_db",
          "leaderboard_service"
        ],
        "dependency_strength": "soft",
        "failure_behavior": "social_service continues with limited functionality if leaderboard_service is down"
      },
      {
        "service": "analytics_service",
        "depends_on": [
          "game_events_queue"
        ],
        "dependency_strength": "hard",
        "failure_behavior": "analytics_service cannot process events without queue connectivity but system continues"
      }
    ]
  }
}